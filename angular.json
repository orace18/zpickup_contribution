{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "zpickup_admin": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/zpickup_admin",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/app/features/dashboard/pages/assets",
                "output": "/assets"
              }
            ],
            "styles": [
             "node_modules/ngx-toastr/toastr.css",
              "src/app/features/dashboard/pages/assets/css/style.bundle.css",
              "src/app/features/dashboard/pages/assets/plugins/custom/datatables/datatables.bundle.css",
              "src/styles.css"
            ],
            "scripts": [
              "src/app/features/dashboard/pages/assets/js/scripts.bundle.js",
              "src/app/features/dashboard/pages/assets/js/widgets.bundle.js",
              "src/app/features/dashboard/pages/assets/js/custom/widgets.js",
              "src/app/features/dashboard/pages/assets/js/widgets.bundle.js",
              "src/app/features/dashboard/pages/assets/js/custom/widgets.js",
              "src/app/features/dashboard/pages/assets/js/custom/apps/chat/chat.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/upgrade-plan.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/type.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/budget.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/settings.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/team.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/targets.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/files.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/complete.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-project/main.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/select-location.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/create-app.js",
              "src/app/features/dashboard/pages/assets/js/custom/utilities/modals/users-search.js",
              "src/app/features/dashboard/pages/assets/plugins/custom/datatables/datatables.bundle.js",
              "node_modules/apexcharts/dist/apexcharts.min.js" 
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "optimization": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "zpickup_admin:build:production"
            },
            "development": {
              "buildTarget": "zpickup_admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/magenta-violet.css",
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
